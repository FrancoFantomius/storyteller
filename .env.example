# =============================================================================
# Storyteller AI - AMD ROCm GPU Docker Environment Configuration
# =============================================================================

# AMD GPU Architecture Override:
# -----------------------------------------------------------------------------
# Most consumer AMD Radeon GPUs require setting HSA_OVERRIDE_GFX_VERSION so
# ROCm matches the kernel binaries:
#
# - AMD Radeon RX 7900 XTX / 7900 XT / 7800 XT / 7700 XT / 7600 (RDNA3): 11.0.0
# - AMD Radeon RX 6950 XT / 6900 XT / 6800 XT / 6800 / 6700 XT (RDNA2):  10.3.0
# - AMD Radeon RX 6600 XT / 6600 (RDNA2 Navi 23):                         10.3.0
# - AMD Radeon RX 5700 XT / 5700 (RDNA1 Navi 10):                         10.1.0
# - AMD Radeon VII / Vega 64 / Vega 56:                                   9.0.0
# - AMD Radeon MI200 / MI300 / W7900 / W6800:                             (Native supported, or 11.0.0 / 10.3.0)
HSA_OVERRIDE_GFX_VERSION=11.0.0

# LLM (llama.cpp) Configuration
# -----------------------------------------------------------------------------
# Place your GGUF model file inside the ./models/llm/ directory
LLAMA_MODEL_FILENAME=model.gguf
LLAMA_N_GPU_LAYERS=99
LLAMA_CTX_SIZE=4096

# Diffusers (Image Generation) Configuration
# -----------------------------------------------------------------------------
# HuggingFace repository ID or path inside ./models/diffusers
# Fast 1-step / 4-step options:
# - stabilityai/sd-turbo
# - stabilityai/sdxl-turbo
# - runwayml/stable-diffusion-v1-5
# - Lykon/dreamshaper-8
DIFFUSERS_MODEL_ID=stabilityai/sd-turbo
