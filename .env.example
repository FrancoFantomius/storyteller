# =============================================================================
# Storyteller AI - Environment & Model Configuration
# =============================================================================
# Quickstart:
# 1. Download `docker-compose.yml` and `.env.example`
# 2. Copy `.env.example` to `.env` (optional: adjust HSA_OVERRIDE_GFX_VERSION for your AMD GPU)
# 3. Run: `docker compose up -d`
# Everything (LLM, Image generation models, Backend & Frontend) will download and initialize automatically.
# =============================================================================

# AMD GPU Architecture Override (ROCm / HIP):
# -----------------------------------------------------------------------------
# - AMD Radeon RX 7900 XTX / 7900 XT / 7800 XT / 7700 XT / 7600 (RDNA3): 11.0.0
# - AMD Radeon RX 6950 XT / 6900 XT / 6800 XT / 6800 / 6700 XT (RDNA2):  10.3.0
# - AMD Radeon RX 6600 XT / 6600 (RDNA2 Navi 23):                         10.3.0
# - AMD Radeon RX 5700 XT / 5700 (RDNA1 Navi 10):                         10.1.0
# - AMD Radeon VII / Vega 64 / Vega 56:                                   9.0.0
# - AMD Radeon MI200 / MI300 / W7900 / W6800:                             11.0.0 / 10.3.0
HSA_OVERRIDE_GFX_VERSION=11.0.0

# Text LLM Configuration (Dolphin-Mistral 7B)
# -----------------------------------------------------------------------------
# Downloaded automatically by llama.cpp on first container launch into ./models/llm/
LLAMA_MODEL_REPO_ID=bartowski/dolphin-2.8-mistral-7b-v02-GGUF
LLAMA_MODEL_FILENAME=dolphin-2.8-mistral-7b-v02-Q6_K.gguf
LLAMA_N_GPU_LAYERS=99
LLAMA_CTX_SIZE=4096

# Diffusers (Image Generation) Configuration
# -----------------------------------------------------------------------------
# Downloaded automatically on first container launch into ./models/diffusers/
# Fast options:
# - stabilityai/sd-turbo (default, ultra-fast 1-4 step)
# - stabilityai/sdxl-turbo
# - runwayml/stable-diffusion-v1-5
# - Lykon/dreamshaper-8
DIFFUSERS_MODEL_ID=stabilityai/sd-turbo

# Optional Hugging Face Access Token (for gated repositories)
# HF_TOKEN=hf_...
